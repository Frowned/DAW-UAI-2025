@using BE.Enums
@using BE.Entities
@using Infrastructure.Session
@using WebUI.Components.Shared
@inject NavigationManager Navigation
@inject IUserBLL UserBLL
@inject ILanguageBLL LanguageBLL
@inject IProductBLL ProductBLL
@inject IPointBLL PointBLL
@inject ILogBLL LogBLL
@rendermode InteractiveServer
@inherits LanguageAwareComponentBase

@page "/"
<PageTitle>Inicio - SIFRE</PageTitle>

@if (!IsAuthenticated)
{
    <p>@T("HOME_REDIRECTING", "Redirigiendo al inicio de sesión...")</p>
}
else
{
    <!-- Encabezado de bienvenida -->
    <div class="mb-4">
        <h1 class="display-4 text-primary fw-bold">@string.Format(T("HOME_WELCOME", "¡Bienvenido, {0}!"), Username) 👋</h1>
        <p class="lead text-muted">@GetGreetingMessage()</p>
        <hr class="my-4" />
    </div>

    <!-- Panel de información según permisos -->
    <div class="row g-4">

        @* PANEL DE PUNTOS - Para usuarios con permiso de consultar puntos *@
        @if (HasPermission(PermissionsType.CONSULTAR_PUNTOS))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-success shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">💰 @T("HOME_MY_POINTS", "Mis Puntos")</h5>
                    </div>
                    <div class="card-body text-center">
                        <h2 class="display-3 text-success fw-bold">@UserPoints</h2>
                        <p class="text-muted">@T("HOME_POINTS_AVAILABLE", "Puntos disponibles")</p>
                        @if (UserPoints > 0)
                        {
                            <p class="small text-success">
                                <i class="bi bi-check-circle"></i> @T("HOME_POINTS_TO_REDEEM", "¡Tienes puntos para canjear!")
                            </p>
                        }
                        else
                        {
                            <p class="small text-muted">@T("HOME_ACCUMULATE_POINTS", "Acumula puntos realizando actividades")</p>
                        }
                    </div>
                </div>
            </div>
        }

        @* PANEL DE PRODUCTOS - Para usuarios con permiso de ver productos *@
        @if (HasPermission(PermissionsType.VER_PRODUCTOS))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-info shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">📦 @T("HOME_PRODUCT_CATALOG", "Catálogo de Productos")</h5>
                    </div>
                    <div class="card-body text-center">
                        <h2 class="display-3 text-info fw-bold">@AvailableProducts</h2>
                        <p class="text-muted">@T("HOME_PRODUCTS_AVAILABLE", "Productos disponibles")</p>
                        @if (AvailableProducts > 0)
                        {
                            <p class="small text-info">
                                <i class="bi bi-star-fill"></i> @T("HOME_CHECK_CATALOG", "Revisa el catálogo en el menú")
                            </p>
                        }
                    </div>
                </div>
            </div>
        }

        @* PANEL DE ADMINISTRACIÓN - Para administradores *@
        @if (HasPermission(PermissionsType.GESTIONAR_PRODUCTOS))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-warning shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">⚙️ @T("HOME_ADMINISTRATION", "Administración")</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-warning">@T("HOME_CONTROL_PANEL", "Panel de Control")</h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <span class="badge bg-success">@TotalProducts</span> @T("HOME_TOTAL_PRODUCTS", "Productos totales")
                            </li>
                            <li class="mb-2">
                                <span class="badge bg-primary">@ActiveProducts</span> @T("HOME_ACTIVE_PRODUCTS", "Productos activos")
                            </li>
                            <li class="mb-2">
                                <span class="badge bg-secondary">@TotalCategories</span> @T("HOME_CATEGORIES", "Categorías")
                            </li>
                        </ul>
                        <p class="small text-muted mb-0">@T("HOME_MANAGE_SYSTEM", "Gestiona el sistema desde el menú de configuración")</p>
                    </div>
                </div>
            </div>
        }

        @* PANEL DE REPORTERÍA - Para usuarios con acceso a reportería *@
        @if (HasPermission(PermissionsType.VER_REPORTERIA))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-primary shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">📊 @T("HOME_RECENT_ACTIVITY", "Actividad Reciente")</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-primary">@T("HOME_SYSTEM_EVENTS", "Eventos del sistema")</h6>
                        <div class="text-center my-3">
                            <h2 class="display-4 text-primary fw-bold">@RecentLogsCount</h2>
                            <p class="small text-muted">@T("HOME_EVENTS_24H", "eventos en las últimas 24 horas")</p>
                        </div>
                        <div class="small text-center">
                            @if (HasRecentActivity)
                            {
                                <span class="badge bg-success">@T("HOME_ACTIVE_SYSTEM", "Sistema activo")</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@T("HOME_LOW_ACTIVITY", "Poca actividad reciente")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* PANEL DE BACKUP - Para administradores con acceso a backup *@
        @if (HasPermission(PermissionsType.GESTIONAR_BACKUP))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-secondary shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">💾 @T("HOME_SYSTEM", "Sistema")</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-secondary">@T("HOME_SECURITY_BACKUPS", "Seguridad y Backups")</h6>
                        <p class="small text-muted">
                            @T("HOME_ACCESS_TOOLS", "Accede a las herramientas de administración del sistema desde el menú de configuración")
                        </p>
                        <div class="small">
                            <span class="badge bg-success">@T("HOME_OPERATIONAL_SYSTEM", "Sistema operativo")</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* PANEL DE IDIOMAS - Para usuarios con acceso a gestión de idiomas *@
        @if (HasPermission(PermissionsType.GESTIONAR_IDIOMA))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-info shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">🌍 @T("HOME_LANGUAGES", "Idiomas")</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-info">@T("HOME_MULTILANGUAGE_SYSTEM", "Sistema Multiidioma")</h6>
                        <p class="small mb-2">
                            <span class="badge bg-info">@TotalLanguages</span> @T("HOME_LANGUAGES_CONFIGURED", "idiomas configurados")
                        </p>
                        <p class="small text-muted mb-0">
                            @T("HOME_MANAGE_TRANSLATIONS", "Gestiona las traducciones desde el menú de configuración")
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Mensaje de ayuda si no tiene ningún permiso especial -->
    @if (!HasAnyDashboardPermission())
    {
        <div class="alert alert-info mt-4">
            <h5 class="alert-heading">
                <i class="bi bi-info-circle"></i> @T("HOME_WELCOME_SIFRE", "Bienvenido al sistema SIFRE")
            </h5>
            <p class="mb-0">
                @T("HOME_USE_MENU", "Utiliza el menú lateral para navegar por las opciones disponibles según tus permisos.")
            </p>
        </div>
    }

    <!-- Footer informativo -->
    <div class="mt-5 pt-4 border-top">
        <div class="row text-center text-muted small">
            <div class="col-md-4">
                <i class="bi bi-shield-check"></i> @T("HOME_SECURE_SYSTEM", "Sistema Seguro")
            </div>
            <div class="col-md-4">
                <i class="bi bi-clock"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </div>
            <div class="col-md-4">
                <i class="bi bi-person-badge"></i> @T("HOME_SESSION", "Sesión"): @Username
            </div>
        </div>
    </div>
}

@code {
    private bool IsAuthenticated { get; set; } = false;
    private string Username { get; set; } = string.Empty;

    // Datos del dashboard
    private long UserPoints { get; set; } = 0;
    private int AvailableProducts { get; set; } = 0;
    private int TotalProducts { get; set; } = 0;
    private int ActiveProducts { get; set; } = 0;
    private int TotalCategories { get; set; } = 0;
    private int RecentLogsCount { get; set; } = 0;
    private bool HasRecentActivity => RecentLogsCount > 10;
    private int TotalLanguages { get; set; } = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // IMPORTANTE: Llama al método base para suscribirse a cambios de idioma

        var session = SingletonSession.Instancia;

        if (session.User == null)
        {
            // No forzar recarga completa para evitar NavigationException
            Navigation.NavigateTo("/login", true);
            return;
        }

        IsAuthenticated = true;
        Username = session.User.Username;

        // Cargar datos según permisos
        LoadDashboardData();
    }

    private void LoadDashboardData()
    {
        try
        {
            var session = SingletonSession.Instancia;

            // Cargar puntos del usuario si tiene permiso
            if (HasPermission(PermissionsType.CONSULTAR_PUNTOS))
            {
                UserPoints = PointBLL.GetPointsByUserId(session.User.Id);
            }

            // Cargar productos si tiene permiso
            if (HasPermission(PermissionsType.VER_PRODUCTOS))
            {
                var products = ProductBLL.GetProducts(false, false);
                AvailableProducts = products.Count();
            }

            // Cargar estadísticas de administración
            if (HasPermission(PermissionsType.GESTIONAR_PRODUCTOS))
            {
                var allProducts = ProductBLL.GetProducts(false, true);
                TotalProducts = allProducts.Count();
                ActiveProducts = allProducts.Count(p => !p.EndDate.HasValue || p.EndDate.Value >= DateTime.Now);
                TotalCategories = ProductBLL.GetCategories().Count();
            }

            // Cargar actividad reciente
            if (HasPermission(PermissionsType.VER_REPORTERIA))
            {
                var yesterday = DateTime.Now.AddDays(-1);
                var recentLogs = LogBLL.GetLogs(null, null, yesterday, DateTime.Now);
                RecentLogsCount = recentLogs.Count;
            }

            // Cargar idiomas
            if (HasPermission(PermissionsType.GESTIONAR_IDIOMA))
            {
                TotalLanguages = LanguageBLL.GetAllLanguages().Count;
            }
        }
        catch (Exception)
        {
            // En caso de error, simplemente no mostrar los datos
        }
    }

    private bool HasPermission(PermissionsType permission)
    {
        return SingletonSession.Instancia?.IsInRole(permission) == true;
    }

    private bool HasAnyDashboardPermission()
    {
        return HasPermission(PermissionsType.CONSULTAR_PUNTOS) ||
               HasPermission(PermissionsType.VER_PRODUCTOS) ||
               HasPermission(PermissionsType.GESTIONAR_PRODUCTOS) ||
               HasPermission(PermissionsType.VER_REPORTERIA) ||
               HasPermission(PermissionsType.GESTIONAR_BACKUP) ||
               HasPermission(PermissionsType.GESTIONAR_IDIOMA);
    }

    private string GetGreetingMessage()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12)
            return T("HOME_GREETING_MORNING", "Buenos días. Aquí está el resumen de tu actividad.");
        else if (hour < 18)
            return T("HOME_GREETING_AFTERNOON", "Buenas tardes. Aquí está el resumen de tu actividad.");
        else
            return T("HOME_GREETING_EVENING", "Buenas noches. Aquí está el resumen de tu actividad.");
    }
}