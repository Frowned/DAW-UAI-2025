@using Infrastructure.Helpers
@using Infrastructure.Interfaces.BLL
@using Infrastructure.Session
@using BE.Entities
@using Infrastructure.Mappers
@rendermode InteractiveServer
@inject IUserBLL UserBLL
@inject ILogBLL LogBLL
@inject NavigationManager Navigation
@page "/change-password"

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 500px;">
        <h4 class="text-center mb-4">🔐 Cambio de Contraseña Obligatorio</h4>

        <div class="alert alert-warning text-center mb-4">
            <strong>Su contraseña ha expirado.</strong><br />
            Debe cambiar su contraseña para continuar.
        </div>

        <div class="form-group mb-3">
            <label for="currentPassword" class="form-label">Contraseña Actual</label>
            <input type="password" id="currentPassword" class="form-control" @bind="CurrentPassword" placeholder="Ingrese su contraseña actual" />
        </div>

        <div class="form-group mb-3">
            <label for="newPassword" class="form-label">Nueva Contraseña</label>
            <input type="password" id="newPassword" class="form-control @(IsPasswordInvalid ? "is-invalid" : "")"
                   @bind="NewPassword" @onblur="ValidatePasswordOnBlur" placeholder="Ingrese su nueva contraseña" />
            <small class="form-text text-muted">
                La contraseña debe tener al menos 8 caracteres, incluyendo al menos 1 mayúscula y 1 número.
            </small>
            @if (IsPasswordInvalid)
            {
                <div class="invalid-feedback">
                    @PasswordValidationMessage
                </div>
            }
        </div>

        <div class="form-group mb-4">
            <label for="confirmPassword" class="form-label">Confirmar Nueva Contraseña</label>
            <input type="password" id="confirmPassword" class="form-control" @bind="ConfirmPassword" placeholder="Confirme su nueva contraseña" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary flex-fill" @onclick="HandleChangePassword" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Cambiar Contraseña
            </button>
            <button class="btn btn-secondary" @onclick="CancelChange" disabled="@IsProcessing">
                Cancelar
            </button>
        </div>

        @if (ShowError)
        {
            <div class="alert alert-danger mt-3 mb-0">
                @ErrorMessage
            </div>
        }

        @if (ShowSuccess)
        {
            <div class="alert alert-success mt-3 mb-0">
                @SuccessMessage
            </div>
        }
    </div>
</div>

@code {
    private string CurrentPassword { get; set; } = string.Empty;
    private string NewPassword { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool ShowError { get; set; } = false;
    private bool ShowSuccess { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private bool IsProcessing { get; set; } = false;
    private bool IsPasswordInvalid { get; set; } = false;
    private string PasswordValidationMessage { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Username { get; set; }

    private async Task HandleChangePassword()
    {
        try
        {
            IsProcessing = true;
            ShowError = false;
            ShowSuccess = false;

            // Validate inputs
            if (string.IsNullOrWhiteSpace(CurrentPassword) ||
                string.IsNullOrWhiteSpace(NewPassword) ||
                string.IsNullOrWhiteSpace(ConfirmPassword))
            {
                ErrorMessage = "Todos los campos son obligatorios.";
                ShowError = true;
                return;
            }

            // Validate new password policy (server-side)
            if (!UserBLL.ValidatePassword(NewPassword))
            {
                ErrorMessage = PasswordHelper.GetPasswordRequirements();
                ShowError = true;

                // Log policy validation failure
                LogBLL.Save(new BE.Entities.Log
                {
                    Message = "Password change failed - Policy validation error",
                    CreatedAt = DateTime.Now,
                    CreatedBy = GetCurrentUser(),
                    Type = BE.Entities.LogType.Warning,
                    Module = "ChangePassword"
                });
                return;
            }

            // Validate password confirmation
            if (NewPassword != ConfirmPassword)
            {
                ErrorMessage = "Las contraseñas no coinciden.";
                ShowError = true;
                return;
            }

            // Get username from session or parameter
            string username = SingletonSession.Instancia.User?.Username ?? Username ?? string.Empty;
            if (string.IsNullOrEmpty(username))
            {
                ErrorMessage = "No se pudo determinar el usuario.";
                ShowError = true;
                return;
            }

            // Verify current password
            string encryptedCurrentPassword = EncryptionHelper.Encrypt(CurrentPassword);
            var user = UserBLL.GetByUsernameAndPassword(username, encryptedCurrentPassword);

            if (user == null)
            {
                ErrorMessage = "La contraseña actual es incorrecta.";
                ShowError = true;
                return;
            }

            // Update password
            string encryptedNewPassword = EncryptionHelper.Encrypt(NewPassword);
            UserBLL.UpdatePassword(username, encryptedNewPassword);

            // Log successful password change
            LogBLL.Save(new BE.Entities.Log
            {
                Message = "PasswordChangeSuccess",
                CreatedAt = DateTime.Now,
                CreatedBy = UsersMapper.DtoToUser(user),
                Type = BE.Entities.LogType.Info,
                Module = nameof(ChangePassword)
            });

            SuccessMessage = "Contraseña cambiada exitosamente. Será redirigido al inicio de sesión.";
            ShowSuccess = true;

            // Redirect to login after 2 seconds
            await Task.Delay(2000);
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error al cambiar la contraseña. Intente nuevamente.";
            ShowError = true;

            // Log exception
            LogBLL.Save(new BE.Entities.Log
            {
                Message = $"Password change error: {ex.Message}",
                CreatedAt = DateTime.Now,
                CreatedBy = GetCurrentUser(),
                Type = BE.Entities.LogType.Critical,
                Module = nameof(ChangePassword)
            });
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void CancelChange()
    {
        // Log password change cancellation
        LogBLL.Save(new BE.Entities.Log
        {
            Message = "PasswordChangeRequiredDenied",
            CreatedAt = DateTime.Now,
            CreatedBy = GetCurrentUser(),
            Type = BE.Entities.LogType.Warning,
            Module = nameof(ChangePassword)
        });

        // Clear session and redirect to login
        SingletonSession.Instancia.Logout();
        Navigation.NavigateTo("/login", true);
    }

    private bool IsValidPassword(string password)
    {
        return PasswordHelper.IsValidPassword(password);
    }

    private void ValidatePasswordOnBlur()
    {
        if (!string.IsNullOrEmpty(NewPassword))
        {
            IsPasswordInvalid = !IsValidPassword(NewPassword);
            PasswordValidationMessage = IsPasswordInvalid ? PasswordHelper.GetPasswordRequirements() : string.Empty;
            StateHasChanged();
        }
    }

    private User GetCurrentUser()
    {
        return SingletonSession.Instancia.User != null
            ? UsersMapper.DtoToUser(SingletonSession.Instancia.User)
            : new User { Username = Username ?? "Unknown" };
    }
}