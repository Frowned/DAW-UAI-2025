@page "/consultar-puntos"
@using BE.DTO
@using BE.Enums
@using BLL
@using Infrastructure.Session
@using WebUI.Components.Shared
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@inject IPointBLL PointBLL
@inject SingletonSession SingletonSession
@inherits LanguageAwareComponentBase

<RoleGuard RequiredPermissions="@(new[] { PermissionsType.CONSULTAR_PUNTOS })">
    <h3>@T("VIEWPOINTS_TITLE", "Historial de puntos")</h3>

    <p><strong>@T("VIEWPOINTS_TOTAL_POINTS", "Puntos:")</strong> @totalPuntos</p>

    <table class="table">
        <thead>
            <tr>
                <th>@T("VIEWPOINTS_COL_ID", "ID")</th>
                <th>@T("VIEWPOINTS_COL_USER", "Usuario")</th>
                <th>@T("VIEWPOINTS_COL_PRODUCT", "Producto")</th>
                <th>@T("VIEWPOINTS_COL_POINTS", "Puntos")</th>
                <th>@T("VIEWPOINTS_COL_DATE", "Fecha de transacción")</th>
            </tr>
        </thead>
        <tbody>
            @if (transactions != null)
            {
                @foreach (var transaction in transactions)
                {
                    <tr>
                        <td>@transaction.Id</td>
                        <td>@transaction.User</td>
                        <td>@transaction.Product</td>
                        <td>@transaction.Points</td>
                        <td>@transaction.TransactionDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <button class="btn btn-success" @onclick="Exportar">@T("VIEWPOINTS_BTN_EXPORT", "Exportar")</button>

</RoleGuard>

@code {
    private IList<TransactionDTO> transactions;
    private long totalPuntos;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // IMPORTANTE: Llama al método base para suscribirse a cambios de idioma

        if (SingletonSession.Instancia?.User != null && SingletonSession.Instancia.IsInRole(PermissionsType.CONSULTAR_PUNTOS))
        {
            var userId = SingletonSession.Instancia.User.Id;

            transactions = PointBLL.GetTransactions(false);
            totalPuntos = PointBLL.GetPointsByUserId(userId);
        }
    }

    private async Task Exportar()
    {
         if (transactions == null || !transactions.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", T("VIEWPOINTS_NO_TRANSACTIONS", "No hay transacciones para exportar."));
            return;
        }

        var pdfBytes = PdfExportService.CrearReportePDF(transactions.ToList());
        var base64 = Convert.ToBase64String(pdfBytes);
        var date = DateTime.Now.ToString("yyyyMMddHHmmss");
        await JSRuntime.InvokeVoidAsync("descargarArchivo", $"historial-puntos-{date}.pdf", base64);
    }
}
